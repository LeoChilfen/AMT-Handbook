node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo

# ---- 编译产物 ----
*.exe
*.dll
*.o
*.obj
*.class
*.jar

# ---- 大文件（超过 100MB GitHub 会拒绝，先放网盘吧）----
*.zip
*.7z
*.iso
